Nested if statements
runs both if statements at once. ends in two fis
#!/bin/bash

age=18
grade=85

if [ $age -gt 18 ] then
echo "You are eligible based on age"
if [ $grade -ge 80 ]; then
echo "You are eligible based on grade"
echo "Congrats" You are eligible for a scholarship"
else 
echo "Sorry, you are not eligible"
fi

while loops

while (condition) 
do
 # code to be executed. Loop continues until condition is false
done

count=1

while [ $count -le 5  ]
do 
echo "Count: $count"
((count++)) 
# the above adds 1 for each iteration of the while loop
done

fruits=("apple "banana" "orange"
index=0

while [ $index -lt ${#fruits [@]} ]
do
echo "Fruit: ${fruits[$index]"}
((index++))
done

